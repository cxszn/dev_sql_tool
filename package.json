{
  "name": "migration-sql-studio",
  "version": "0.5.0",
  "private": true,
  "description": "本地 PHP migrations 到 PostgreSQL SQL 的桌面转换工具",
  "type": "module",
  "main": "src/desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:electron": "node node_modules/electron/install.js",
    "start": "electron .",
    "cli": "node src/cli.js",
    "mcp": "node src/mcp.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check.js",
    "preview": "node scripts/preview.js",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "libpg-query-pg16": "npm:libpg-query@16.7.3",
    "pgsql-parser": "18.2.8",
    "php-parser": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.4.5"
  }
}
